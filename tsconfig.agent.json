{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": false,
    "isolatedModules": false,
    "incremental": false,
    "noEmit": true
  },
  "include": ["agent/**/*.ts"],
  "exclude": ["node_modules"]
}
