# GimmeJob AI service
GIMMEJOB_AI_ENVIRONMENT=development
GIMMEJOB_AI_OPENAI_API_KEY=
GIMMEJOB_AI_OPENAI_MODEL=gpt-5.4-mini
GIMMEJOB_AI_SERVICE_TOKEN=
GIMMEJOB_AI_CONTENT_ROOT=../content
GIMMEJOB_AI_REQUEST_TIMEOUT_SECONDS=45

# Single canonical GimmeJob RAG endpoint. Local development may use HTTP localhost;
# production must use HTTPS. The same private token is configured on the Worker as
# GIMMEJOB_RAG_SERVICE_TOKEN.
GIMMEJOB_AI_RAG_URL=http://127.0.0.1:3000/internal/rag/search
GIMMEJOB_AI_RAG_SERVICE_TOKEN=

# Langfuse Cloud. Leave both keys empty to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
