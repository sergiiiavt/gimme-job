# GimmeJob AI service
GIMMEJOB_AI_ENVIRONMENT=development
GIMMEJOB_AI_OPENAI_API_KEY=
GIMMEJOB_AI_OPENAI_MODEL=gpt-5.4-mini
GIMMEJOB_AI_SERVICE_TOKEN=
GIMMEJOB_AI_CONTENT_ROOT=../content
GIMMEJOB_AI_REQUEST_TIMEOUT_SECONDS=45

# Langfuse Cloud. Leave both keys empty to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
