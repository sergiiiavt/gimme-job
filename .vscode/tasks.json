{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GimmeJob: Run locally",
      "type": "npm",
      "script": "local",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "GimmeJob: Verify like CI",
      "type": "npm",
      "script": "verify",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "GimmeJob: Fast verification",
      "type": "npm",
      "script": "verify:fast",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "GimmeJob: Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"],
      "group": "test"
    },
    {
      "label": "GimmeJob: Type-check agent",
      "type": "npm",
      "script": "check:agent",
      "problemMatcher": ["$tsc"],
      "group": "test"
    },
    {
      "label": "GimmeJob: Production build",
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
