# Production hostname. Create a DNS A record pointing this name to the Hetzner VM.
N8N_DOMAIN=n8n.gimme-job.com

# Pin production to a known stable n8n release and upgrade deliberately.
N8N_VERSION=2.32.7

# Generate these only on the server. Never commit real values.
POSTGRES_PASSWORD=replace-with-generated-secret
N8N_ENCRYPTION_KEY=replace-with-generated-secret
