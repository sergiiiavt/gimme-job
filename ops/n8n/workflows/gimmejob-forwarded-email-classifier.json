      "name": "Fetch unclassified email events",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const events = $input.first().json.events;\nif (!Array.isArray(events) || events.length === 0) return [];\n\nconst rules = [\n  ['OFFER', [/\\boffer\\b/i, /\\bemployment agreement\\b/i]],\n  ['TEST_TASK', [/\\btest task\\b/i, /\\btechnical assessment\\b/i, /\\bcoding challenge\\b/i, /\\btake[- ]home\\b/i, /\\bhome assignment\\b/i]],\n  ['INTERVIEW', [/\\binterview\\b/i, /\\bscreening\\b/i, /\\btechnical (?:call|round)\\b/i, /\\bhiring manager\\b/i]],\n  ['REJECTION', [/\\bunfortunately\\b/i, /\\bnot moving forward\\b/i, /\\bother candidates\\b/i, /\\breject(?:ed|ion)?\\b/i, /\\bnot selected\\b/i]],\n  ['RECRUITER', [/\\brecruiter\\b/i, /\\bjob opportunity\\b/i, /\\bvacanc(?:y|ies)\\b/i, /\\bopen position\\b/i, /\\bnew role\\b/i]],\n];\n\nfunction classify(event) {\n  const searchable = [event.subject, event.senderName, event.senderEmail].filter(Boolean).join(' ');\n  for (const [classification, patterns] of rules) {\n    if (patterns.some((pattern) => pattern.test(searchable))) return classification;\n  }\n  return 'OTHER';\n}\n\nreturn events.map((event) => ({\n  json: {\n    userId: event.userId,\n    id: event.id,\n    classification: classify(event),\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
