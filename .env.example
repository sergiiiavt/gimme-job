# Optional: enables structured AI analysis through the OpenAI Agents SDK.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# GimmeJob AI service. The browser never receives the service token; the
# Cloudflare Worker uses it for authenticated server-to-server requests.
GIMMEJOB_AI_URL=
GIMMEJOB_AI_SERVICE_TOKEN=

# Protects the canonical internal RAG search endpoint used by the Python AI
# service. Configure the same value as GIMMEJOB_AI_RAG_SERVICE_TOKEN there.
GIMMEJOB_RAG_SERVICE_TOKEN=

# Optional local path overrides.
JOB_AGENT_DB=./data/job-agent.db
JOB_AGENT_PROFILE=./config/profile.json
JOB_AGENT_SOURCES=./config/sources.json
JOB_AGENT_PORT=4317
# Optional non-secret override for local browser-to-agent discovery. Normally
# derived from this checkout and database path; both processes must share it.
# JOB_AGENT_INSTANCE_ID=

# Cloudflare deployment values. Keep real values in GitHub repository secrets
# or in your terminal session; never commit them to this file.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Legacy private-site password. Retained only so the original private workspace
# can be claimed once by its owner when creating the first normal account.
APP_PASSWORD=
GRAFANA_READ_TOKEN=
N8N_INGEST_TOKEN=

# Normal GimmeJob accounts use email + password and D1-backed sessions.
# Production deployment defaults this to true when the repository variable is unset.
MULTI_USER_ENABLED=true

# Optional experimental Gmail OAuth. These are NOT required for normal sign-in
# or for the recommended per-user email-forwarding integration. Configure all
# three together only if direct Gmail API access is enabled later.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Base64-encoded 32 random bytes used only to encrypt Gmail refresh tokens.
GMAIL_TOKEN_ENCRYPTION_KEY=
