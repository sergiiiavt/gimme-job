# Optional: enables structured AI analysis through the OpenAI Agents SDK.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Optional local path overrides.
JOB_AGENT_DB=./data/job-agent.db
JOB_AGENT_PROFILE=./config/profile.json
JOB_AGENT_SOURCES=./config/sources.json
JOB_AGENT_PORT=4317
# Optional non-secret override for local browser-to-agent discovery. Normally
# derived from this checkout and database path; both processes must share it.
# JOB_AGENT_INSTANCE_ID=

# Cloudflare deployment values. Keep real values in GitHub repository secrets
# or in your terminal session; never commit them to this file.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
APP_PASSWORD=
GRAFANA_READ_TOKEN=
N8N_INGEST_TOKEN=

# Production Google account + per-user Gmail authorization.
# In GitHub Actions, MULTI_USER_ENABLED is supplied as a repository variable;
# the three credential values below are repository secrets. Keep the variable
# false until the Google web OAuth client is configured for the production callback.
MULTI_USER_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Base64-encoded 32 random bytes used only to encrypt Gmail refresh tokens.
GMAIL_TOKEN_ENCRYPTION_KEY=
