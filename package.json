{
  "name": "job-search-local",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "api": "node --import tsx agent/server.ts",
    "local:web": "vite --host 127.0.0.1 --port 4173",
    "local": "concurrently -k -n WEB,AGENT -c cyan,green \"npm run local:web\" \"npm run api\"",
    "build": "bash scripts/build-verified.sh",
    "check:cloudflare": "node scripts/deploy-cloudflare.mjs --dry-run",
    "deploy:cloudflare": "npm run build && node scripts/deploy-cloudflare.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "check:content": "node scripts/validate-interview-content.mjs",
    "check:agent": "tsc -p tsconfig.agent.json",
    "check": "npm run lint && npm run check:agent",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "agent:init": "node --import tsx agent/src/cli.ts init",
    "agent:sync": "node --import tsx agent/src/cli.ts sync",
    "agent:analyze": "node --import tsx agent/src/cli.ts analyze",
    "agent:market": "node --import tsx agent/src/cli.ts market",
    "agent:queue": "node --import tsx agent/src/cli.ts queue",
    "gmail:connect": "node --import tsx agent/src/cli.ts gmail-auth"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@openai/agents": "^0.14.3",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "^5.10.1",
    "googleapis": "^174.0.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^9.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "GimmeJob",
  "overrides": {
    "@google-cloud/local-auth": {
      "google-auth-library": "10.5.0"
    }
  }
}
