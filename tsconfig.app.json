{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "worker/**/*.ts",
    "content/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "examples", "dist", ".next"]
}
